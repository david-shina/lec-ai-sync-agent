# LLM Configuration
# Groq is the PRIMARY LLM (fast, ~1-2s per call)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=gpt-oss-20b

# LM Studio is the OFFLINE FALLBACK (used only if GROQ_API_KEY is empty)
# Start LM Studio and load a model at localhost:1234 before running
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-3b-instruct

# Other settings
MULTI_CONFLICT_GROQ_THRESHOLD=2
HTTP_TIMEOUT_SECONDS=10
DECIDER_MAX_TOKENS=1024